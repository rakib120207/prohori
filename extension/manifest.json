{
  "manifest_version": 3,
  "name": "Prohori – Bangla AI-text checker",
  "short_name": "Prohori",
  "version": "1.0.1",
  "description": "Select Bangla text on any page, right-click, and see how much it reads like AI-written text, with the reasons. A probability, never a verdict.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://prohori-mhuf.onrender.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Prohori: check Bangla text", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "check-selection": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Check the selected text with Prohori"
    }
  }
}
